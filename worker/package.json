{
	"name": "claude-monitor-hooks",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"db:init": "wrangler d1 execute prompt-logger --remote --file=schema.sql",
		"db:local": "wrangler d1 execute prompt-logger --local  --file=schema.sql",
		"db:migrate": "wrangler d1 execute prompt-logger --remote --file=migrations/0001_add_account_email.sql",
		"db:migrate-auth": "wrangler d1 execute prompt-logger --remote --file=migrations/0002_auth.sql",
		"db:migrate-logto": "wrangler d1 execute prompt-logger --remote --file=migrations/0003_logto.sql"
	},
	"dependencies": {
		"fflate": "^0.8.3",
		"jose": "^5.10.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@cloudflare/workers-types": "^4.0.0",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^3.101.0"
	}
}
